# Base URL of the API that serves the operator.* endpoints (see api-spec/operator.yml).
VITE_API_URL=http://localhost:3002
# "on" serves every request from the in-browser mock backend in src/api/mock — no API needed.
# Leave empty to talk to VITE_API_URL.
VITE_API_MOCK=on
# Maps: the same tile server the dash uses (kdsx-api/docker-compose-geo.yml: tiles and fonts).
# Unset: `npm run dev` borrows public OpenStreetMap tiles so maps still draw; a build shows the
# list without a map.
# VITE_MAP_TILES_URL=https://<tile server>
# VITE_MAP_ARCHIVE=uzbekistan
# VITE_MAP_GLYPHS=https://<font server>/font/{fontstack}/{range}
