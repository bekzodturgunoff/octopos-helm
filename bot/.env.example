# From @BotFather (/newbot → octopos_helm_bot). Secret: never commit it.
TELEGRAM_BOT_TOKEN=
# The operator.* API, the same as Helm's VITE_API_URL.
HELM_API_URL=http://localhost:3002
# Shared with the server: the bot sends it as X-Bot-Key on /bot.telegram.redeem.
HELM_BOT_KEY=
# Shared with the server: it sends events to this bot with "Authorization: Bearer <EVENTS_SECRET>".
EVENTS_SECRET=
# Where Helm is, for "Open in Helm" buttons.
HELM_APP_URL=https://helm.octopos.uz
# Where clients' dashes live: <slug>.<DASH_DOMAIN>.
DASH_DOMAIN=dash.octopos.uz
# The port the server sends events to.
PORT=8787
# Who is linked; keep it on a volume that survives deploys.
DATA_FILE=./data/bot.json
# The team group's language: uz, ru or en.
TEAM_LANGUAGE=uz
